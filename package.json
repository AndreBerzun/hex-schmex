{
  "name": "terrain-prompter",
  "version": "0.1.0",
  "description": "Prompt-and-paint terrain generator for a Shadowdark westmarches hexcrawl",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "tsx scripts/shots.ts",
    "prompt": "tsx scripts/prompt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  },
  "private": true,
  "type": "module"
}
