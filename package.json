{
  "name": "terrain-prompter",
  "version": "0.1.0",
  "description": "Prompt-and-paint terrain generator for a Shadowdark westmarches hexcrawl",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "tsx scripts/shots.ts",
    "perf": "tsx scripts/perf.ts",
    "check:player": "tsx scripts/player-check.ts",
    "check:materials": "tsx scripts/material-check.ts",
    "check:flight": "tsx scripts/flight-check.ts",
    "check:shore": "tsx scripts/shore-check.ts",
    "check:bake": "tsx scripts/bake-check.ts",
    "check:layers": "tsx scripts/layers-check.ts",
    "terrain": "tsx scripts/terrain.ts",
    "gallery": "tsx scripts/gallery.ts",
    "check:scenery": "tsx scripts/scenery-check.ts",
    "probe:scenery": "tsx scripts/scenery-probe.ts",
    "check:fps-baseline": "tsx scripts/fps-baseline.ts",
    "shots:biomes": "tsx scripts/biome-shots.ts"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.9"
  },
  "private": true,
  "type": "module"
}
