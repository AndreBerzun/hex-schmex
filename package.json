{
  "name": "terrain-prompter",
  "version": "0.1.0",
  "description": "Prompt-and-paint terrain generator for a Shadowdark westmarches hexcrawl",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "tsx scripts/shots.ts",
    "perf": "tsx scripts/perf.ts",
    "terrain": "tsx scripts/terrain.ts"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.9"
  },
  "private": true,
  "type": "module"
}
